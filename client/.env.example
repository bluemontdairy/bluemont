# Copy to .env and fill in. Never commit .env.
#
# Server credentials live here. Business settings (the site's address,
# contact details, WhatsApp, social links, notification emails) are set in
# the admin panel under Site settings, in the database.

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/bluemont

# --- Admin auth ---
# At least 32 random characters. Encrypts two-step sign-in keys and secrets
# saved in Site settings. Keep it the same on every server: if it changes,
# those have to be set up again.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Cloudinary (product photos, site images, hero video) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder for this site's uploads (default "bluemont").
CLOUDINARY_FOLDER=

# --- Email (lead alerts, password resets, invites, security notices) ---
# Gmail: smtp.gmail.com, port 465, and an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display sender. Wrap it in single quotes so the address survives:
# SMTP_FROM='"Blue Mont Website" <no-reply@example.com>'
SMTP_FROM=
