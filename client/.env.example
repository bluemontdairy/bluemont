# Copy to .env.local and fill in. Never commit .env.local.

# --- Database & auth ---
MONGODB_URI=mongodb://127.0.0.1:27017/bluemont
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Public site details (shown on the website and in SEO tags) ---
NEXT_PUBLIC_SITE_URL=https://bluemont.com.np
# Wholesale desk WhatsApp number, digits only with country code, e.g. 97798XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SALES_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=info@bluemont.com.np

# --- Email alerts for new leads and contact messages ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display sender, e.g. "Blue Mont Website <no-reply@bluemont.com.np>"
SMTP_FROM=
# Comma-separated list of management inboxes
MANAGEMENT_EMAIL=

# --- Google Sheet copy of B2B leads (see docs/google-sheet-setup.md) ---
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
